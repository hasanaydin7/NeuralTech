{
  "name": "neural-editor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/neural-editor",
  "prefix": "neural",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/neural-editor/ng-package.json",
        "tsConfig": "libs/neural-editor/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/neural-editor/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "include": ["**/*.spec.ts"],
        "watch": false
      }
    },
    "package-test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node libs/neural-editor/scripts/test-package.mjs"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
