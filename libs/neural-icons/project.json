{
  "name": "neural-icons",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/neural-icons",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node libs/neural-icons/scripts/generate-icons.mjs --write-source"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "node libs/neural-icons/scripts/generate-icons.mjs --check=libs/neural-icons/icons.css",
          "node libs/neural-icons/scripts/test-package.mjs"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "command": "node libs/neural-icons/scripts/generate-icons.mjs --out-dir=dist/libs/neural-icons"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  },
  "tags": []
}
