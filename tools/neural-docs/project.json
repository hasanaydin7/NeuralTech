{
  "name": "neural-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "tools/neural-docs",
  "targets": {
    "contract-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/neural-docs/scripts/check-contract.mjs"
      }
    },
    "example-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/neural-docs/scripts/check-examples.mjs"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/neural-docs/scripts/check-coverage.mjs"
      }
    },
    "class-contract-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/neural-docs/scripts/generate-class-contracts.mjs --check"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "contract-check",
        "example-check",
        "coverage",
        "class-contract-check"
      ],
      "options": {
        "command": "node -e \"console.log('Neural docs verification passed.')\""
      }
    }
  },
  "tags": ["scope:docs", "type:tooling"]
}
